    "            note_parts.append(random.choice(barrier_phrases))\n",
    "        else: \n",
    "            if random.random() <0.6:\n",
    "                note_parts.append(random.choice(stable_phrases))\n",
    "\n",
    "    return \". \".join(note_parts)\n"
