    "        WHEN CAST(AppointmentDay AS DATE) - CAST(ScheduledDay AS DATE) > 30 THEN '30+ Days'\n",
    "    END AS wait_bucket\n",
    "FROM appointments;\n",
    "\"\"\")"
   ]
